## HiGHS CMake configuration file

set(@PACKAGE_PREFIX@_VERSION @PROJECT_VERSION@)

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)

# Let users know about optional features
set(HIGHS_HAVE_BLAS @HIPO@)

# Written by a build with HiPO, for the BLAS it was built with
if(HIGHS_HAVE_BLAS)
  include("${CMAKE_CURRENT_LIST_DIR}/highs-blas-dependency.cmake" OPTIONAL)
endif()

@CONF_ZLIB@

include("${CMAKE_CURRENT_LIST_DIR}/highs-targets.cmake")
