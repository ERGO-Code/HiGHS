prefix=@CMAKE_INSTALL_PREFIX@
libdir=@CMAKE_INSTALL_FULL_LIBDIR@
includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@/highs

Name: HiGHS
Description: Linear Optimization Software
URL: https://github.com/ERGO-Code/HiGHS
Version: @HIGHS_VERSION_MAJOR@.@HIGHS_VERSION_MINOR@.@HIGHS_VERSION_PATCH@
Libs: -L${libdir} -lhighs
Libs.private: @HIGHS_PC_LIBS_PRIVATE@
Cflags: -I${includedir}
Requires:
Requires.private: @HIGHS_PC_REQUIRES_PRIVATE@
